; Role-3 USB-tree enumerator for the UCX replacement package. Its legacy WDM
; host-controller protocol is incomplete; the packaged UCX role-2 driver supplies
; the host-controller behavior for this deployment path.

[Version]
Signature = "$Windows NT$"
Class = System
ClassGuid = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider = %ProviderName%
DriverVer = 11/16/2026,1.0.0.13
CatalogFile.NTamd64 = xusb_reconstructed_tree.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
xusb_driver.sys = 1

[Manufacturer]
%ProviderName% = Models,NTamd64.10.0...19041

[Models.NTamd64.10.0...19041]
%UsbTreeDesc% = UsbTree_Install, root\*xusb_tree

[UsbTree_Install.NT]
CopyFiles = DriverCopy

[UsbTree_Install.NT.Services]
AddService = xusb_virt,0x00000002,UsbTree_Service

[DriverCopy]
xusb_driver.sys

[UsbTree_Service]
DisplayName = %UsbTreeServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\xusb_driver.sys
LoadOrderGroup = Extended Base

[Strings]
ProviderName = "Virtual Device Camera reconstructed driver"
DiskName = "Virtual Device Camera reconstructed driver"
UsbTreeDesc = "Virtual USB tree enumerator (experimental reconstruction)"
UsbTreeServiceDesc = "Virtual USB tree enumerator (experimental reconstruction)"
