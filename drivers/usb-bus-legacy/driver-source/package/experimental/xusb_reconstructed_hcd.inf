; Experimental legacy Host Controller role.
; This only binds the recovered device ID. The reconstructed driver does not
; implement a complete UCX or Usbport host-controller contract.

[Version]
Signature = "$Windows NT$"
Class = USB
ClassGuid = {36FC9E60-C465-11CF-8056-444553540000}
Provider = %ProviderName%
DriverVer = 11/15/2026,1.0.0.0
CatalogFile.NTamd64 = xusb_reconstructed_hcd.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
xusb_driver.sys = 1

[Manufacturer]
%ProviderName% = Models,NTamd64

[Models.NTamd64]
%HostControllerDesc% = HostController_Install, PCI\VEN_37FA&DEV_FE09&SUBSYS_9976A077&REV_88

[HostController_Install.NT]
CopyFiles = DriverCopy

[HostController_Install.NT.Services]
AddService = xusb_controller,0x00000002,HostController_Service

[DriverCopy]
xusb_driver.sys

[HostController_Service]
DisplayName = %HostControllerServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\xusb_driver.sys
LoadOrderGroup = Extended Base

[Strings]
ProviderName = "Virtual Device Camera reconstructed driver"
DiskName = "Virtual Device Camera reconstructed driver"
HostControllerDesc = "Virtual USB host controller (experimental reconstruction)"
HostControllerServiceDesc = "Virtual USB host controller (experimental reconstruction)"
