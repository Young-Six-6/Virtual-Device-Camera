<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6F60E5B7-A1BF-4EFA-BBA8-629B1F305679}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>VirtualDeviceCamera</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset Condition="'$(VisualStudioVersion)' &gt;= '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)'==''">v143</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset Condition="'$(VisualStudioVersion)' &gt;= '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)'==''">v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <FFmpegRoot Condition="'$(FFmpegRoot)'==''">$(ProjectDir).deps\ffmpeg</FFmpegRoot>
    <OutDir>$(ProjectDir)build\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)build\obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>virtual-device-camera</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!-- Zero-length protocol tails are required to preserve the legacy driver ABI. -->
      <DisableSpecificWarnings>4200;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <AdditionalIncludeDirectories>$(ProjectDir)src\camera;$(ProjectDir)src\protocol;$(ProjectDir)src\usb;$(FFmpegRoot)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(FFmpegRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>avformat.lib;avcodec.lib;swscale.lib;avutil.lib;setupapi.lib;advapi32.lib;ws2_32.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <LinkIncremental>true</LinkIncremental>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <LinkIncremental>false</LinkIncremental>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\app\main.cpp" />
    <ClCompile Include="src\app\control_server.cpp" />
    <ClCompile Include="src\app\app_config.cpp" />
    <ClCompile Include="src\app\runtime_controller.cpp" />
    <ClCompile Include="src\app\web_server.cpp" />
    <ClCompile Include="src\camera\uvc_vcam.cpp" />
    <ClCompile Include="src\camera\uvc_device.cpp" />
    <ClCompile Include="src\camera\camera_session.cpp" />
    <ClCompile Include="src\media\frame_source.cpp" />
    <ClCompile Include="src\media\pipe_reader.cpp" />
    <ClCompile Include="src\usb\virt_dev.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\camera\uvc_vcam.h" />
    <ClInclude Include="src\camera\camera_session.h" />
    <ClInclude Include="src\camera\uvc_device.h" />
    <ClInclude Include="src\app\control_server.h" />
    <ClInclude Include="src\app\app_config.h" />
    <ClInclude Include="src\app\runtime_controller.h" />
    <ClInclude Include="src\app\web_server.h" />
    <ClInclude Include="src\common\win_handle.h" />
    <ClInclude Include="src\common\resolution.h" />
    <ClInclude Include="src\common\pipe_io.h" />
    <ClInclude Include="src\common\pipe_security.h" />
    <ClInclude Include="src\media\frame_source.h" />
    <ClInclude Include="src\media\pipe_reader.h" />
    <ClInclude Include="src\protocol\uvc_struct.h" />
    <ClInclude Include="src\usb\ioctl.h" />
    <ClInclude Include="src\usb\virt_dev.h" />
    <ClInclude Include="src\usb\transport.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="config\default_res.txt" />
    <None Include="config\camera.ini" />
  </ItemGroup>

  <Target Name="ValidateFFmpeg" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <FFmpegAvformatRuntime Include="$(FFmpegRoot)\bin\avformat-*.dll" />
      <FFmpegAvcodecRuntime Include="$(FFmpegRoot)\bin\avcodec-*.dll" />
      <FFmpegSwscaleRuntime Include="$(FFmpegRoot)\bin\swscale-*.dll" />
      <FFmpegAvutilRuntime Include="$(FFmpegRoot)\bin\avutil-*.dll" />
      <FFmpegSwresampleRuntime Include="$(FFmpegRoot)\bin\swresample-*.dll" />
    </ItemGroup>
    <Error Condition="!Exists('$(FFmpegRoot)\include\libavformat\avformat.h') Or !Exists('$(FFmpegRoot)\lib\avformat.lib')" Text="FFmpeg SDK missing. Run scripts\setup.ps1 -FFmpegSource &lt;shared SDK directory&gt;, or set FFmpegRoot." />
    <Error Condition="'@(FFmpegAvformatRuntime)'=='' Or '@(FFmpegAvcodecRuntime)'=='' Or '@(FFmpegSwscaleRuntime)'=='' Or '@(FFmpegAvutilRuntime)'=='' Or '@(FFmpegSwresampleRuntime)'==''" Text="FFmpeg shared runtime DLLs are incomplete in $(FFmpegRoot)\bin." />
  </Target>

  <Target Name="CopyApplicationRuntime" AfterTargets="Build">
    <ItemGroup>
      <FFmpegRuntime Include="$(FFmpegRoot)\bin\avformat-*.dll" />
      <FFmpegRuntime Include="$(FFmpegRoot)\bin\avcodec-*.dll" />
      <FFmpegRuntime Include="$(FFmpegRoot)\bin\swscale-*.dll" />
      <FFmpegRuntime Include="$(FFmpegRoot)\bin\avutil-*.dll" />
      <FFmpegRuntime Include="$(FFmpegRoot)\bin\swresample-*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FFmpegRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)config\default_res.txt" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)config\camera.ini" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="!Exists('$(OutDir)camera.ini')" />
  </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
